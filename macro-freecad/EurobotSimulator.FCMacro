# -*- coding: utf-8 -*-
"""EurobotSimulator.FCMacro

Connecte FreeCAD au serveur WebSocket du robot (log_server.cpp, port 81)
pour afficher sa position en temps reel sur un terrain 3D et envoyer les
memes commandes que la page web embarquee (data/index.html) :
goto, state_cmd, servo.

Aucune dependance externe : uniquement la bibliotheque standard Python
(socket/threading/json/...) plus FreeCAD/FreeCADGui/PySide deja fournis
par l'application. Le client WebSocket (handshake + framing RFC 6455)
est reimplemente a la main pour eviter tout pip install.
"""

import base64
import hashlib
import json
import os
import queue
import socket
import struct
import threading

import FreeCAD as App
import FreeCADGui as Gui
import Part

try:
    from PySide6 import QtCore, QtWidgets
except ImportError:
    from PySide2 import QtCore, QtWidgets

DOC_NAME = "EurobotSimulator"
# TABLE_W_MM/TABLE_H_MM : src/config.h, TABLE_WIDTH_MM / TABLE_HEIGHT_MM.
TABLE_W_MM = 3000.0
TABLE_H_MM = 2000.0
# Gabarit chassis (axe des roues = origine locale, X+ = avant) :
# ROBOT_BACK_TO_CENTER_MM (config.h) = 80.9mm ; avant non defini dans le
# firmware, suppose symetrique en l'absence de mesure. Largeur/hauteurs
# fournies manuellement (absentes du firmware) : caisse 230x320mm + mat
# de balise (cylindre 80mm diam.) centre, montant jusqu'a 430mm de haut.
ROBOT_BACK_TO_CENTER_MM = 80.9
ROBOT_FRONT_TO_CENTER_MM = 80.9
ROBOT_W_MM = 230.0
ROBOT_H_MM = 320.0
BEACON_DIAM_MM = 80.0
BEACON_TOTAL_H_MM = 430.0

DEFAULT_HOST = "192.168.4.1"   # IP par defaut en mode AP (config.h WIFI_USE_STA=0)
DEFAULT_PORT = 81              # port WebSocket fixe du firmware

STATE_ACTIONS = [
    ("Stop moteurs", "stop_motors"),
    ("Activer moteurs", "enable_motors"),
    ("WAIT_INIT", "wait_init"),
    ("Lancer Init", "restart_init"),
    ("Lancer Match", "start_match"),
    ("Stop match", "stop_match"),
    ("Relancer Match", "restart_match"),
]

SERVO_IDS = ["brasDroit", "brasGauche", "lifter", "gripper"]
SEQ_BUTTONS = [("Sequence Init", "seq_init"), ("Sequence Prise", "seq_prise")]

# Pas de capteur de position sur les servos (cf. actuators/servo.cpp,
# _currentDeg = NAN au boot, mis a jour seulement par un setAngle() explicite).
# Le firmware ne connait donc pas la position physique reelle tant qu'aucune
# commande n'a ete envoyee depuis le demarrage. Valeurs de repos par defaut
# reprises de data/index.html (mêmes attributs value="..." codes en dur),
# en attendant le premier vrai message "act".
DEFAULT_SERVO_PCT = {"brasDroit": 48, "brasGauche": 50, "lifter": 14, "gripper": 0}

